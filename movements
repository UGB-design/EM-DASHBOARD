<!DOCTYPE html>
<html>

<head>

  <base target="_top">

  <style>

    * {
      box-sizing: border-box;
    }

    html, body {
      overflow-x: hidden;
      height: 100%;
    }

    body {
      margin: 0;
      padding: 16px;
      font-family: Arial, sans-serif;
      background: #eef1f6;
      color: #12305a;

      height: 100vh;
      overflow: hidden;

      display: flex;
      flex-direction: column;
    }

    .container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;

      flex: 1;

      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    #content {
      flex: 1;

      display: flex;
      flex-direction: column;
      min-height: 0;
    }


    /* =========================
       TITLE
       ========================= */

    .title {
      margin-bottom: 16px;
      margin-top: 4px;
      text-align: center;
    }

    .firm-name {
      margin: 0;
      font-size: 22px;
      letter-spacing: 0.5px;
      color: #12305a;
      font-weight: 800;
    }

    .title h2 {
      margin: 6px 0 0;
      font-size: 18px;
      letter-spacing: 1px;
      color: #0757b8;
      font-weight: 700;
    }

    .title-line {
      width: 258px;
      height: 2px;
      background: #d9ad22;
      margin: 7px auto 0;
    }


    /* =========================
       MAIN PHOTO
       ========================= */

    .photo-area {
      width: 100%;
      position: relative;

      background: #d9dee6;
      border-radius: 16px;
      overflow: hidden;

      flex: 1;
      min-height: 0;

      display: flex;
      align-items: center;
      justify-content: center;
    }

    .photo-area img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
    }

    .counter {
      position: absolute;
      right: 14px;
      bottom: 14px;

      background: rgba(15, 30, 55, 0.75);
      color: #ffffff;

      font-size: 13px;
      font-weight: 600;

      padding: 5px 12px;
      border-radius: 8px;
    }


    /* =========================
       THUMBNAILS
       ========================= */

    .thumb-strip {
      display: flex;
      gap: 8px;

      margin-top: 12px;

      flex-shrink: 0;
    }

    .thumb {
      flex: 0 0 90px;
      width: 90px;

      aspect-ratio: 16 / 10;

      border-radius: 8px;
      overflow: hidden;

      border: 2px solid transparent;

      cursor: pointer;

      background: #d9dee6;
    }

    .thumb.active {
      border-color: #0757b8;
    }

    .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }


    /* =========================
       INFO CARD
       ========================= */

    .info-card {
      margin-top: 16px;

      background: #ffffff;
      border: 1px solid #d8e4f2;
      border-radius: 14px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);

      padding: 20px 22px;

      flex-shrink: 0;
      position: relative;
    }

    .upload-corner {
      position: absolute;
      top: 20px;
      right: 22px;

      font-size: 12px;
      color: #8a96a6;
      text-align: right;
    }

    .event-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: #ffffff;
      background: #0757b8;
      padding: 5px 12px;
      border-radius: 14px;
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    .employee {
      font-size: 26px;
      font-weight: 800;
      color: #12305a;
      margin-bottom: 16px;
    }

    .detail-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .detail-item {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .detail-icon {
      width: 34px;
      height: 34px;
      min-width: 34px;

      border-radius: 50%;
      background: #eaf2fc;

      display: flex;
      align-items: center;
      justify-content: center;
    }

    .detail-icon svg {
      width: 17px;
      height: 17px;
      stroke: #0757b8;
    }

    .detail-text {
      font-size: 13px;
      color: #40536d;
      line-height: 1.35;
    }

    .detail-text strong {
      display: block;
      color: #193d6b;
      font-weight: 700;
      font-size: 13px;
    }

    .detail-divider {
      width: 1px;
      align-self: stretch;
      background: #e3e9f1;
    }


    /* =========================
       LOADING / EMPTY / ERROR
       ========================= */

    .loading, .empty, .error {
      background: #ffffff;
      border: 1px solid #dce7f5;
      border-radius: 12px;
      padding: 40px;
      text-align: center;
      color: #718096;
      font-size: 13px;
    }

    .error {
      border-color: #ead8d8;
      color: #9a5555;
    }


    /* =========================
       MOBILE
       ========================= */

    @media (max-width: 600px) {

      .employee {
        font-size: 20px;
      }

      .detail-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }

      .detail-divider {
        display: none;
      }

      .thumb-strip {
        gap: 6px;
      }

      .thumb {
        flex: 0 0 64px;
        width: 64px;
      }

    }

  </style>

</head>


<body>


<div class="container">


  <!-- TITLE -->

  <div class="title">

    <div class="firm-name">UMESH BOLMAL &amp; ASSOCIATES</div>

    <h2>OFFICE MOMENTS</h2>

    <div class="title-line"></div>

  </div>


  <!-- CONTENT -->

  <div id="content">
  </div>


</div>



<script>

  let photos = [];       // flat list from server
  let groups = [];        // grouped by employee+event+date

  let groupIndex = 0;     // which celebration
  let photoIndex = 0;     // which photo inside that celebration

  let autoSlideTimer = null;
  const preloadedImages = {};



  /* ==========================================
     GROUP FLAT PHOTOS INTO CELEBRATIONS
     Consecutive items with the same employee +
     eventType + uploadedDate came from the same
     form submission -> same celebration.
     ========================================== */

  function buildGroups(list) {

    const result = [];

    list.forEach(function(item) {

      const last = result[result.length - 1];

      const sameGroup =
        last &&
        last.employee === item.employee &&
        last.eventType === item.eventType &&
        last.uploadedDate === item.uploadedDate;

      if (sameGroup) {
        last.items.push(item);
      } else {
        result.push({
          employee: item.employee,
          eventType: item.eventType,
          birthday: item.birthday,
          age: item.age,
          service: item.service,
          uploadedDate: item.uploadedDate,
          items: [item]
        });
      }

    });

    return result;

  }



  /* ==========================================
     PRELOAD
     ========================================== */

  function preloadImage(url) {

    if (!url || preloadedImages[url]) {
      return;
    }

    const img = new Image();
    img.src = url;
    preloadedImages[url] = img;

  }


  function preloadAllPhotos() {

    photos.forEach(function(item) {
      preloadImage(item.imageUrl);
      preloadImage(item.imageUrlAlt);
    });

  }


  function preloadUrls(urls) {

    const promises = urls.map(function(url) {

      return new Promise(function(resolve) {

        if (!url) {
          resolve();
          return;
        }

        const existing = preloadedImages[url];

        if (existing && existing.complete) {
          resolve();
          return;
        }

        const img = new Image();

        img.onload = function() {
          preloadedImages[url] = img;
          resolve();
        };

        img.onerror = function() {
          resolve();
        };

        img.src = url;

      });

    });

    return Promise.all(promises);

  }



  /* ==========================================
     AUTO-ADVANCE EVERY 10 SECONDS
     Moves through photos inside a celebration
     first, then moves to the next celebration.
     ========================================== */

  function startAutoSlide() {

    if (autoSlideTimer) {
      clearInterval(autoSlideTimer);
    }

    if (photos.length > 1) {

      autoSlideTimer = setInterval(function() {
        advance();
      }, 10000);

    }

  }


  function advance() {

    const currentGroup = groups[groupIndex];

    if (!currentGroup) return;

    if (photoIndex < currentGroup.items.length - 1) {

      photoIndex++;

    } else {

      photoIndex = 0;
      groupIndex++;

      if (groupIndex >= groups.length) {
        groupIndex = 0;
      }

    }

    showPhoto();

  }



  /* ==========================================
     LOAD PHOTOS
     ========================================== */

  function loadPhotos() {

    google.script.run

      .withSuccessHandler(function(data) {

        const newPhotos = data || [];


        if (newPhotos.length === 0) {

          if (photos.length === 0) {

            document.getElementById("content").innerHTML =

              '<div class="empty">' +
              'No celebration photos yet.' +
              '</div>';

          }

          return;

        }


        const urls = [];

        newPhotos.forEach(function(item) {
          if (item.imageUrl) urls.push(item.imageUrl);
          if (item.imageUrlAlt) urls.push(item.imageUrlAlt);
        });

        preloadUrls(urls).then(function() {

          photos = newPhotos;
          groups = buildGroups(photos);

          if (groupIndex >= groups.length) {
            groupIndex = 0;
            photoIndex = 0;
          }

          try {
            localStorage.setItem('officeMomentsCache', JSON.stringify(photos));
          } catch (e) {
            console.log(e);
          }

          showPhoto();

          startAutoSlide();

        });

      })


      .withFailureHandler(function(error) {

        console.log(error);

        if (photos.length === 0) {

          document.getElementById("content").innerHTML =

            '<div class="error">' +
            'Unable to load celebration photos.' +
            '</div>';

        }

      })


      .getBirthdayPhotos();

  }



  /* ==========================================
     SHOW CURRENT PHOTO
     ========================================== */

  function showPhoto() {

    const group = groups[groupIndex];

    if (!group) return;

    const item = group.items[photoIndex];

    const url = item.imageUrl;
    const cached = preloadedImages[url];

    if (cached && cached.complete && cached.naturalWidth > 0) {

      renderPhoto(group, item);

    } else {

      const loader = new Image();

      loader.onload = function() {
        preloadedImages[url] = loader;
        renderPhoto(group, item);
      };

      loader.onerror = function() {
        renderPhoto(group, item);
      };

      loader.src = url;

    }

  }


  function selectThumb(idx) {

    photoIndex = idx;
    showPhoto();
    startAutoSlide();

  }


  function renderPhoto(group, item) {


    /* ------------------------------
       MAIN IMAGE
       ------------------------------ */

    let imageHtml = "";

    if (item.imageUrl) {

      imageHtml =

        '<img ' +

        'src="' + escapeHtml(item.imageUrl) + '" ' +
        'alt="' + escapeHtml(group.employee) + '" ' +
        'data-alt="' + escapeHtml(item.imageUrlAlt || '') + '" ' +
        'onerror="photoError(this)"' +

        '>';

    }


    /* ------------------------------
       THUMBNAILS (only if more than 1
       photo in this celebration)
       ------------------------------ */

    let thumbHtml = "";

    if (group.items.length > 1) {

      thumbHtml = '<div class="thumb-strip">';

      group.items.forEach(function(photoItem, idx) {

        thumbHtml +=

          '<div class="thumb ' +
          (idx === photoIndex ? 'active' : '') +
          '" onclick="selectThumb(' + idx + ')">' +

          '<img src="' + escapeHtml(photoItem.imageUrl) + '" ' +
          'data-alt="' + escapeHtml(photoItem.imageUrlAlt || '') + '" ' +
          'onerror="photoError(this)">' +

          '</div>';

      });

      thumbHtml += '</div>';

    }


    /* ------------------------------
       IS THIS A BIRTHDAY CARD?
       ------------------------------ */

    const isBirthdayCard =
      String(group.eventType || 'Birthday').toUpperCase() === 'BIRTHDAY';


    /* ------------------------------
       DETAIL ITEMS
       ------------------------------ */

    let detailItems = "";

    if (isBirthdayCard && group.birthday) {

      let birthdayValue = escapeHtml(group.birthday);

      if (group.age !== undefined && group.age !== null && group.age !== "") {
        birthdayValue += ' &middot; ' + escapeHtml(group.age) + ' years';
      }

      detailItems +=

        '<div class="detail-item">' +
          '<div class="detail-icon">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
              '<rect x="3" y="4" width="18" height="18" rx="3"></rect>' +
              '<line x1="16" y1="2" x2="16" y2="6"></line>' +
              '<line x1="8" y1="2" x2="8" y2="6"></line>' +
              '<line x1="3" y1="10" x2="21" y2="10"></line>' +
            '</svg>' +
          '</div>' +
          '<div class="detail-text"><strong>Birthday</strong>' + birthdayValue + '</div>' +
        '</div>';

    }

    if (isBirthdayCard && group.service) {

      detailItems +=

        '<div class="detail-divider"></div>' +

        '<div class="detail-item">' +
          '<div class="detail-icon">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
              '<circle cx="9" cy="8" r="3"></circle>' +
              '<path d="M2 20c0-3.3 3-6 7-6s7 2.7 7 6"></path>' +
              '<circle cx="17" cy="9" r="2.5"></circle>' +
              '<path d="M17 13c2.5 0 5 1.6 5 4.5"></path>' +
            '</svg>' +
          '</div>' +
          '<div class="detail-text"><strong>With Umesh Bolmal &amp; Associates</strong>' + escapeHtml(group.service) + '</div>' +
        '</div>';

    }

    let uploadCornerHtml = "";

    if (group.uploadedDate) {

      if (isBirthdayCard) {

        detailItems +=

          '<div class="detail-divider"></div>' +

          '<div class="detail-item">' +
            '<div class="detail-icon">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
                '<rect x="3" y="3" width="18" height="18" rx="3"></rect>' +
                '<circle cx="8.5" cy="9.5" r="1.7"></circle>' +
                '<path d="M21 16l-5.5-5.5L3 21"></path>' +
              '</svg>' +
            '</div>' +
            '<div class="detail-text"><strong>Photo uploaded</strong>' + escapeHtml(group.uploadedDate) + '</div>' +
          '</div>';

      } else {

        uploadCornerHtml =
          '<div class="upload-corner">Photo uploaded<br>' + escapeHtml(group.uploadedDate) + '</div>';

      }

    }


    /* ------------------------------
       DISPLAY
       ------------------------------ */

    document.getElementById("content").innerHTML = `

      <div class="photo-area">

        ${imageHtml}

        <div class="counter">${photoIndex + 1} / ${group.items.length}</div>

      </div>

      ${thumbHtml}

      <div class="info-card">

        ${uploadCornerHtml}

        ${isBirthdayCard ? '<div class="event-badge">Office Movements</div>' : ''}

        <div class="employee">${isBirthdayCard ? escapeHtml(group.employee) : escapeHtml(group.eventType)}</div>

        <div class="detail-row">
          ${detailItems}
        </div>

      </div>

    `;

  }



  /* ==========================================
     PHOTO ERROR
     ========================================== */

  function photoError(img) {

    const altUrl = img.getAttribute('data-alt');

    if (altUrl && img.src !== altUrl && !img.dataset.triedAlt) {

      img.dataset.triedAlt = "1";
      img.src = altUrl;
      return;

    }

    img.style.display = "none";

    img.parentElement.innerHTML +=

      '<div style="' +

      'font-size:13px;' +
      'color:#7d8998;' +
      'text-align:center;' +
      'padding:20px;' +

      '">' +

      'Photo is not available to display. Check the file\'s sharing setting (Anyone with the link - Viewer).' +

      '</div>';

  }



  /* ==========================================
     ESCAPE HTML
     ========================================== */

  function escapeHtml(text) {

    return String(text)

      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }



  /* ==========================================
     FIRST LOAD (from cache, then refresh)
     ========================================== */

  function loadFromCache() {

    try {

      const raw = localStorage.getItem('officeMomentsCache');

      if (raw) {

        const cached = JSON.parse(raw);

        if (Array.isArray(cached) && cached.length > 0) {

          photos = cached;
          groups = buildGroups(photos);

          groupIndex = 0;
          photoIndex = 0;

          preloadAllPhotos();
          showPhoto();
          startAutoSlide();

          return true;

        }

      }

    } catch (e) {
      console.log(e);
    }

    return false;

  }


  loadFromCache();

  loadPhotos();


  setInterval(function() {

    loadPhotos();

  }, 60000);


</script>


</body>

</html>
